# --- UniFi Protect ---
# IP/hostname till din UniFi OS-konsol (Dream Machine, Cloud Key, UNVR, etc.)
PROTECT_HOST=192.168.1.1
PROTECT_PORT=443
# Lokalt Protect-konto (Settings > Users). Rekommenderat: eget "viewer"-konto,
# inte ditt Ubiquiti-cloud-konto.
PROTECT_USERNAME=viewer
PROTECT_PASSWORD=changeme
# UniFi OS använder oftast självsignerat cert -> false
PROTECT_VERIFY_SSL=false
# Kommaseparerad lista av kamera-ID:n att bevaka. Tomt = alla kameror.
CAMERA_IDS=
# Minsta antal sekunder mellan analyser per kamera (undvik spam vid ihållande rörelse)
EVENT_COOLDOWN_SECONDS=60

# --- Ollama (extern server) ---
OLLAMA_URL=http://192.168.1.50:11434
# OBS: llava klarar inte tvåbilds-jämförelser på vissa Ollama-versioner
# ("Chunk not found"-fel från servern) - gemma4:e4b-it-qat verifierat funka
# med två bilder samt bäst svenska av testade modeller.
OLLAMA_MODEL=gemma4:e4b-it-qat
OLLAMA_TIMEOUT_SECONDS=120
# Hur länge Ollama håller modellen i VRAM efter ett anrop. -1 = för alltid
# (kräver ~5,5 GB VRAM permanent för gemma4:e4b-it-qat). Ollamas egen default
# (5m) gav kallstarter som ofta tog längre än timeouten, så de flesta
# rörelser efter en lugn stund aldrig analyserades. Tal = sekunder, eller
# en duration som "60m".
OLLAMA_KEEP_ALIVE=-1
# Prompt som används när det INTE finns någon referensbild att jämföra mot
# (t.ex. direkt vid uppstart). Om du skriver en egen ANALYSIS_PROMPT: behåll
# sista meningen om "svara med exakt ordet ..." - annars kan modellen aldrig
# signalera "inget att se" och varje rörelse går rakt till Discord. Markören
# (ZQX9WKM73VT5) måste matcha NOTHING_MARKER i app/main.py exakt.
ANALYSIS_PROMPT=Beskriv kort på svenska vad du ser i denna bild från en säkerhetskamera. Fokusera på människor, fordon, djur eller annat ovanligt. Max två meningar. Om bilden inte visar något av intresse (tom scen, inga människor/fordon/djur, bara t.ex. vind i grenar eller ljusförändring): svara med exakt ordet ZQX9WKM73VT5 och inget annat.
# Prompt som används när en referensbild (bakgrund) finns, för att kunna
# ignorera saker som stått där hela tiden (t.ex. en parkerad bil). Lämna
# okommenterad rad borttagen/kommenterad för att använda inbyggd standard.
#COMPARISON_PROMPT=
# Hur ofta (sekunder) en ny referensbild tas per kamera i vila, så den vet
# vad som är "normalt" (t.ex. bilar som stått parkerade länge)
BASELINE_REFRESH_SECONDS=900
# Andel pixlar (0.0-1.0) som måste skilja sig mot referensbilden för att
# overhuvudtaget skicka till Ollama. Filtrerar bort stillastående objekt
# (t.ex. en parkerad bil) mekaniskt, utan att lita på att modellen själv
# tolkar prompten rätt. Höj vid falska larm, sänk om riktig rörelse missas.
DIFF_RATIO_THRESHOLD=0.02
# Ignorerade områden per kamera (ROI), JSON-dict kameranamn -> polygon av
# [x,y]-punkter i andelar (0.0-1.0) av bildens bredd/höjd. Allt INNANFÖR
# polygonen (t.ex. vägen) ignoreras helt - både i pixel-diffen och i det
# Ollama får se. Tomt = ingen maskering, hela bilden bevakas (standard).
# Ta fram punkterna med scripts/roi_preview.py mot en exempelbild.
# Exempel - en yta uppe i bild (t.ex. vägen bakom tomten) ignoreras:
#ROI_MASKS={"Carport": [[0.42,0.0],[0.86,0.0],[0.86,0.14],[0.43,0.15]]}

# --- Discord ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy
